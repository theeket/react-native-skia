-    _cxx = "$win_vc/Tools/MSVC/$win_toolchain_version/bin/HostX64/$target_cpu/cl.exe"
+    _cc = "$win_vc/Tools/MSVC/$win_toolchain_version/bin/Host$host_cpu/$current_cpu/cl.exe"
+    _cxx = "$win_vc/Tools/MSVC/$win_toolchain_version/bin/Host$host_cpu/$current_cpu/cl.exe"
   }
   _dawn_lib_name = "dawn_combined.lib"
   _tint_lib_name = "tint_combined.lib"
