 import("//third_party/dawn/args.gni")
+
+_dawn_cpu = target_cpu
+_tint_cpu = host_cpu
+if (is_win) {
+  # Each library must match the toolchain consuming it, including host tools.
+  _dawn_cpu = current_cpu
+  _tint_cpu = current_cpu
+}
 
 if (is_win) {
   # On Windows, the normal cc/cxx variables are just "clang" and "clang++"
@@ -19,8 +27,8 @@
