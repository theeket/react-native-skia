# Windows wasm uses a GCC-like host for the Python-only Emsdk activation action.
# That context reports msvc_host, so also accept the requested gcc_like_host label.

diff --git a/gn/toolchain/emsdk/BUILD.gn b/gn/toolchain/emsdk/BUILD.gn
--- a/gn/toolchain/emsdk/BUILD.gn
+++ b/gn/toolchain/emsdk/BUILD.gn
@@ -1,4 +1,6 @@
-if (current_toolchain == "//gn/toolchain:$host_toolchain") {
+if (current_toolchain == "//gn/toolchain:$host_toolchain" ||
+    (host_os == "win" &&
+     current_toolchain == "//gn/toolchain:gcc_like_host")) {
   action("activate") {
     script = "//bin/activate-emsdk"
     args = []
