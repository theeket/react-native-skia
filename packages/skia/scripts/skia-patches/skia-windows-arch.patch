[windows] Keep host tools and target libraries on matching architectures

The Windows builder supplies native host_cpu and initializes Visual Studio
separately for each target. HostX64 compilers run under x64 emulation on
Windows on Arm, making compilation much slower even for ARM64 output.

Keep each Dawn/Tint compiler, archiver, CMake processor, and SDK library
directory on the consuming toolchain's CPU. Pairing an ARM64 compiler with
x64 libraries produces mixed-architecture linker errors.

Honor explicit /GR without also adding /GR-, avoiding warning D9025.
Other platforms retain their existing settings.

Use ninja.exe on Windows so depot_tools batch wrappers cannot break long
dependency-query command lines after compilation has already succeeded.

---

# Select native MSVC host executables while keeping the requested target CPU.
# Hardcoded HostX64 runs under emulation on ARM64 hosts, making compilation much slower.
# Windows helper commands use python, including wasm archive creation.
diff --git a/gn/toolchain/BUILD.gn b/gn/toolchain/BUILD.gn
--- a/gn/toolchain/BUILD.gn
+++ b/gn/toolchain/BUILD.gn
@@ -51,13 +51,19 @@
   }
 }
 
+# Windows helper commands must not require a python3 alias.
+python = "python3"
+if (host_os == "win") {
+  python = "python"
+}
+
 template("msvc_toolchain") {
   toolchain(target_name) {
     toolchain_target_cpu = invoker.cpu
     lib_switch = ""
     lib_dir_switch = "/LIBPATH:"
 
-    bin = "$win_vc/Tools/MSVC/$win_toolchain_version/bin/HostX64/$toolchain_target_cpu"
+    bin = "$win_vc/Tools/MSVC/$win_toolchain_version/bin/Host$host_cpu/$toolchain_target_cpu"
 
     cl_m32_flag = ""
 
@@ -201,7 +207,7 @@
 
     tool("copy") {
       cp_py = rebase_path("../cp.py")
-      command = "$shell python3 \"$cp_py\" {{source}} {{output}}"
+      command = "$shell $python \"$cp_py\" {{source}} {{output}}"
       description = "copy {{source}} {{output}}"
     }
 
@@ -294,7 +300,7 @@
         rspfile = "{{output}}.rsp"
         rspfile_content = "{{inputs}}"
         rm_py = rebase_path("../rm.py")
-        command = "$shell python3 \"$rm_py\" \"{{output}}\" && $ar rcs {{output}} @$rspfile"
+        command = "$shell $python \"$rm_py\" \"{{output}}\" && $ar rcs {{output}} @$rspfile"
       }
 
       outputs =
@@ -395,13 +401,13 @@
 
     tool("copy") {
       cp_py = rebase_path("../cp.py")
-      command = "python3 \"$cp_py\" {{source}} {{output}}"
+      command = "$python \"$cp_py\" {{source}} {{output}}"
