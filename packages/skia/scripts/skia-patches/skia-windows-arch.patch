# Avoid conflicting /GR- when the target explicitly enables /GR; preserve host defaults.
diff --git a/gn/skia/BUILD.gn b/gn/skia/BUILD.gn
--- a/gn/skia/BUILD.gn
+++ b/gn/skia/BUILD.gn
@@ -755,7 +755,11 @@
   # -fsanitize=undefined
   if (sanitize != "ASAN") {
     if (is_win) {
-      cflags_cc = [ "/GR-" ]
+      # Honor an explicit RTTI opt-in without conflicting MSVC flags.
+      if (current_toolchain != default_toolchain ||
+          filter_include(extra_cflags_cc, [ "/GR" ]) == []) {
+        cflags_cc = [ "/GR-" ]
+      }
     } else {
       cflags_cc = [ "-fno-rtti" ]
       cflags_objcc = cflags_cc

# Match Dawn/Tint to the consuming toolchain CPU and pass the compiler host CPU separately.
# Otherwise an ARM64 compiler can receive x64 libraries, causing mixed-architecture link errors.
