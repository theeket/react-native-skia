       "--win_vc=" + win_vc,

# Use host-native SDK tools and archivers; keep SDK libraries on the target CPU.
# Query ninja.exe directly on Windows: depot_tools batch wrappers can fail on long argument lists.
diff --git a/third_party/dawn/cmake_utils.py b/third_party/dawn/cmake_utils.py
--- a/third_party/dawn/cmake_utils.py
+++ b/third_party/dawn/cmake_utils.py
@@ -38,6 +38,8 @@
